# Copy to .env.local (gitignored) and fill in. In GitHub Actions each of these is a repository secret.

# intervals.icu → Settings → Developer Settings → "API Key".
INTERVALS_API_KEY=
# intervals.icu → Settings → Developer Settings → "Athlete ID" (looks like i123456).
INTERVALS_ATHLETE_ID=
# The coach's sheet: paste its URL or just the id in docs.google.com/spreadsheets/d/<ID>/edit — then share the sheet with the service account's e-mail as Viewer.
GOOGLE_SHEET_ID=
# Google Cloud Console → IAM & Admin → Service Accounts → your account → Keys → Add key → JSON; paste the whole file on one line, wrapped in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Supabase dashboard → Project Settings → Data API → Project URL.
SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → service_role / secret key. Server-side only — never in the frontend.
SUPABASE_SERVICE_KEY=
# Your current bodyweight in kg (added to bodyweight exercises such as dips and chins).
BODYWEIGHT=
# Strength-TSS calibration factor from strength_collector.py (its original value was 0.02); tune against cycling TSS.
STRENGTH_K=

# --- web/ (Next.js dashboard) ---
# Next.js only reads env files from its own folder: put these two in web/.env.local (gitignored),
# and in Vercel as server-side environment variables. Never prefix them with NEXT_PUBLIC_.
# SUPABASE_URL=            same value as above
# SUPABASE_SERVICE_KEY=    same kind of key as above; on Vercel prefer a separate secret key you can revoke on its own
