# Copy to .env.local (gitignored) and fill in. In GitHub Actions each of these is a repository secret.
# GitHub secrets: paste the raw value only (no quotes around it). Numbers use a decimal point (0.10).
# Check them all at once: `uv run check-config` locally, or the first step of the daily workflow.

# intervals.icu → Settings → Developer Settings → "API Key".
INTERVALS_API_KEY=
# intervals.icu → Settings → Developer Settings → "Athlete ID" (looks like i123456).
INTERVALS_ATHLETE_ID=
# The coach's sheet: paste its URL or just the id in docs.google.com/spreadsheets/d/<ID>/edit — then share the sheet with the service account's e-mail as Viewer.
GOOGLE_SHEET_ID=
# Google Cloud Console → IAM & Admin → Service Accounts → your account → Keys → Add key → JSON.
# .env.local: the whole file on one line, wrapped in single quotes. GitHub secret: paste the JSON as-is, no quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Supabase dashboard → Project Settings → Data API → Project URL.
SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → service_role / secret key. Server-side only — never in the frontend.
SUPABASE_SERVICE_KEY=
# Your current bodyweight in kg, e.g. 82.5. A bodyweight exercise adds BODYWEIGHT x its bodyweight_fraction
# (public.exercises, edited in Supabase) to the logged kg.
BODYWEIGHT=
# Strength-TSS factor for the sheet score (strength_collector.py's formula; its original value was 0.02). Decimal point: 0.035, not 0,035.
# Anchor (user, 2026-10-02): ~60 TSS per heavy strength session. Not calibrated: 0.10 gave 153-197 TSS a session, intervals.icu's
# HR load for the same sessions was 19-22 (a floor: HR understates lifting). Changing it recomputes all history.
# In CI this is a repository VARIABLE (vars.STRENGTH_K), not a secret.
STRENGTH_K=0.035

# --- web/ (Next.js dashboard) ---
# Next.js only reads env files from its own folder: put these two in web/.env.local (gitignored),
# and in Vercel as server-side environment variables. Never prefix them with NEXT_PUBLIC_.
# SUPABASE_URL=            same value as above
# SUPABASE_SERVICE_KEY=    same kind of key as above; on Vercel prefer a separate secret key you can revoke on its own
# "Hent data nu" (POST /api/refresh starts daily.yml): a fine-grained GitHub token for this repository only,
# Repository permissions → Actions: Read and write (nothing else). Vercel: Production scope only. Unset = the ↻
# answers "ikke slået til her". Not needed in GitHub Actions. Give it an expiry (e.g. 1 year) and rotate it then, or at
# once if it leaks (its holder could start, cancel or delete runs of daily.yml; it can't read secrets or push).
# GITHUB_DISPATCH_TOKEN=
